# Copy to `.env` and adjust as needed.
#
# The app needs NO API keys — every data source (MLB Stats API, Baseball
# Savant) is a public endpoint. Everything below is optional.

# ---------------------------------------------------------------------------
# Rate limiting (src/middleware.ts, applied to /api/* only)
# ---------------------------------------------------------------------------
# NOTE: state is per process, so this is a SOFT cap, not a security control.
# On serverless each instance keeps its own counters, so N instances allow
# roughly N times the limit. Use a shared store (Redis/Upstash) if you need a
# real guarantee. See src/lib/rate-limit.ts.

# Set to "false" to disable entirely (useful for local development).
# RATE_LIMIT_ENABLED="true"

# Window length in milliseconds. Default 60000.
# RATE_LIMIT_WINDOW_MS="60000"

# Requests per window for ordinary endpoints. Default 120.
# RATE_LIMIT_MAX="120"

# Requests per window for endpoints that pull large Statcast CSVs upstream
# (fastest-pitches, home-run-derby, leaderboard, player-zones, simulate).
# Tracked separately, so heavy requests cannot exhaust the general allowance.
# Default 20.
# RATE_LIMIT_MAX_EXPENSIVE="20"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error | silent
# Defaults to `debug` outside production and `info` in production. Output is
# pretty-printed in development and JSON-lines in production.
# LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Live-feed WebSocket mini-service (mini-services/live-feed)
# ---------------------------------------------------------------------------
# Optional file to append service logs to, in addition to stdout. Leave unset
# to log to stdout only — the right choice under systemd/Docker/pm2, which
# capture stdout themselves.
# LOG_FILE="/var/log/stitches-live-feed.log"
