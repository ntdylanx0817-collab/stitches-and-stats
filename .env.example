# Copy to `.env` and adjust as needed.
#
# The app needs NO API keys — every data source (MLB Stats API, Baseball
# Savant) is a public endpoint. Everything below is optional.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Only required if you run `prisma db push` / `prisma generate`. The app's
# request path does not read from the database today.
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# Live-feed WebSocket mini-service (mini-services/live-feed)
# ---------------------------------------------------------------------------
# Optional file to append service logs to, in addition to stdout. Leave unset
# to log to stdout only — the right choice under systemd/Docker/pm2, which
# capture stdout themselves.
# LOG_FILE="/var/log/stitches-live-feed.log"
